const fs=require('fs'),path=require('path'),crypto=require('crypto');const root=process.env.OPENCODE_RECOVERY_ROOT||path.resolve(__dirname,'..');
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');const read=p=>JSON.parse(fs.readFileSync(path.join(root,p),'utf8'));
const bundleManifest=read('reports/bundle-manifest.json'),standalone=read('reports/standalone-build.json'),build=read('reports/source-build.json');
if(!build.complete||!standalone.success)throw Error('Build is incomplete');
let sourceModules=0;const errors=[];
for(const bundle of bundleManifest.bundles){const report=read('reports/build/'+bundle.id+'.json'),base=root+'/recovered/esm/'+bundle.id,modules=JSON.parse(fs.readFileSync(base+'/modules.json'));const names=['entry.mjs',...modules.modules.map(m=>m.file)];const inputHash=hash(Buffer.concat(names.map(n=>Buffer.concat([Buffer.from(n+'\0'),fs.readFileSync(path.join(base,n))]))));if(inputHash!==report.inputHash)errors.push('Source changed since build: '+bundle.id);const out=root+'/generated/source-build/'+bundle.artifactPath;if(hash(fs.readFileSync(out))!==report.outputHash)errors.push('Output changed: '+bundle.id);sourceModules+=modules.modules.length;}
for(const f of standalone.files){if(hash(fs.readFileSync(root+'/'+f.source))!==f.sourceHash)errors.push('Standalone source changed: '+f.source);if(hash(fs.readFileSync(root+'/generated/source-build/'+f.artifactPath))!==f.sha256)errors.push('Standalone output changed: '+f.artifactPath);}
const product=read('generated/source-build/resources/app/product.json');for(const [name,expected]of Object.entries(product.checksums||{})){const actual=crypto.createHash('sha256').update(fs.readFileSync(root+'/generated/source-build/resources/app/out/'+name)).digest('base64').replace(/=+$/,'');if(actual!==expected)errors.push('Product integrity mismatch: '+name);}
const result={success:!errors.length,recoveredESModules:sourceModules,compiledBundles:bundleManifest.bundles.length,compiledStandaloneFiles:standalone.files.length,compiledApplicationJavaScriptFiles:bundleManifest.bundles.length+standalone.files.length,productIntegrityChecks:Object.keys(product.checksums||{}).length,mode:'recovered-JavaScript-source-build',originalTypeScriptTypesRestored:false,nativeDependencies:'vendored',errors,verifiedAt:new Date().toISOString()};fs.writeFileSync(root+'/reports/build-verification.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));if(errors.length)process.exitCode=1;
