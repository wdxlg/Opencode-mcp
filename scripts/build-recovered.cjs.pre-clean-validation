const fs=require('fs'),path=require('path'),crypto=require('crypto');
const root=process.env.OPENCODE_RECOVERY_ROOT||path.resolve(__dirname,'..');const esbuild=require(root+'/toolchain/node_modules/esbuild');
const out=root+'/generated/source-build',reports=root+'/reports/build';fs.mkdirSync(reports,{recursive:true});
if(!fs.existsSync(out)){fs.mkdirSync(out,{recursive:true});fs.cpSync(root+'/baseline',out,{recursive:true,errorOnExist:true,force:false});fs.writeFileSync(out+'/RECOVERY-OUTPUT.json',JSON.stringify({mode:'recovered-modular-javascript-build',fullOriginalTypeScriptRestoration:false,electronAndDependencies:'vendored',source:root},null,2));}
const manifest=JSON.parse(fs.readFileSync(root+'/reports/bundle-manifest.json'));const result=[];
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
(async()=>{for(const bundle of manifest.bundles){const base=root+'/recovered/esm/'+bundle.id,meta=base+'/modules.json';if(!fs.existsSync(meta)){result.push({id:bundle.id,status:'source-not-ready'});continue;}const modules=JSON.parse(fs.readFileSync(meta));const names=['entry.mjs',...modules.modules.map(m=>m.file)];const inputHash=hash(Buffer.concat(names.map(n=>Buffer.concat([Buffer.from(n+'\0'),fs.readFileSync(path.join(base,n))]))));const dest=path.join(out,bundle.artifactPath),reportPath=reports+'/'+bundle.id+'.json';const old=fs.existsSync(reportPath)?JSON.parse(fs.readFileSync(reportPath)):null;
if(old?.success&&old.inputHash===inputHash&&old.compiler===esbuild.version&&fs.existsSync(dest)&&hash(fs.readFileSync(dest))===old.outputHash){result.push({id:bundle.id,status:'unchanged'});continue;}
try{const format=bundle.artifactPath.startsWith('resources/app/extensions/opencode/')?'cjs':'esm';const r=await esbuild.build({entryPoints:[base+'/entry.mjs'],outfile:dest,bundle:true,format,platform:format==='cjs'?'node':'neutral',target:'esnext',treeShaking:false,minify:false,sourcemap:'external',sourcesContent:true,metafile:true,logLevel:'silent',plugins:[{name:'retain-runtime-imports',setup(build){build.onResolve({filter:/.*/},args=>{if(args.kind==='entry-point')return;const resolved=path.resolve(args.resolveDir,args.path);if(resolved.startsWith(path.resolve(base)+path.sep)&&fs.existsSync(resolved))return {path:resolved};return {path:args.path,external:true};});}}]});const report={success:true,id:bundle.id,artifactPath:bundle.artifactPath,inputHash,compiler:esbuild.version,format,sourceModules:modules.modules.length,compiledInputs:Object.keys(r.metafile.inputs).length,outputHash:hash(fs.readFileSync(dest)),bytes:fs.statSync(dest).size,warnings:r.warnings.map(w=>({text:w.text,location:w.location})),at:new Date().toISOString()};fs.writeFileSync(reportPath,JSON.stringify(report,null,2));fs.writeFileSync(reports+'/'+bundle.id+'.metafile.json',JSON.stringify(r.metafile));result.push({id:bundle.id,status:'compiled',sourceModules:report.sourceModules,bytes:report.bytes,warnings:report.warnings.length});console.log('COMPILED '+JSON.stringify(result.at(-1)));}
catch(e){const report={success:false,id:bundle.id,inputHash,errors:e.errors||String(e)};fs.writeFileSync(reportPath,JSON.stringify(report,null,2));result.push({id:bundle.id,status:'failed',errorCount:report.errors.length,examples:report.errors.slice(0,3).map(e=>({text:e.text,file:e.location?.file,line:e.location?.line}))});console.error('BUILD_FAILED '+JSON.stringify(result.at(-1)));}}
const report={mode:'recovered-modular-javascript-build',compiler:esbuild.version,output:out,results:result,complete:result.every(r=>r.status==='compiled'||r.status==='unchanged'),originalTypeScriptRestored:false,applicationExecuted:false};fs.writeFileSync(root+'/reports/source-build.json',JSON.stringify(report,null,2));console.log('SOURCE_BUILD '+JSON.stringify(report));if(!report.complete)process.exitCode=2;})().catch(e=>{console.error(e);process.exitCode=1;});
